# Static server for the built SPA. Every unknown path returns index.html because
# the router lives in the browser: /monitors is a route, not a file, and a 404
# there would break every deep link and every reload.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode gzip zstd

	# Hashed assets are immutable; index.html must never be cached, or a deploy
	# leaves browsers holding a page that points at assets that no longer exist.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
