# UpControl self-host configuration. Copy to .env (install.sh writes it for
# you) — everything here is optional; the defaults run a working single-user
# instance on localhost. Secrets (passwords, tokens, API keys) live as files
# under ./secrets/, NOT here — see the README.

# Image tag to run. Releases are tagged (v1.2.3); `latest` tracks the newest
# release. ./install.sh --update pulls whatever this names.
UC_VERSION=latest

# Public domain for the instance (status.example.com). Set = Caddy provisions
# a real certificate and serves the app there. Empty = localhost with Caddy's
# internal CA, and plain-HTTP ingest on :80 for SDKs (see README, "TLS").
UC_DOMAIN=

# The origin links in outbound email point at. Set together with UC_DOMAIN,
# e.g. https://status.example.com — unused until SMTP is configured.
UC_PUBLIC_ORIGIN=

# Auth mode. `none` (default): no sign-in — the instance boots with one owner
# account and every request acts as them. Right for a single-operator box
# that is not internet-facing. `magic-link`: email sign-in codes; pair it
# with SMTP below, or fish codes out of the ucapi log (README, "Signing in").
UC_AUTH=none

# The owner account `none` mode provisions at boot. The address is an
# identity, not a mailbox — nothing is sent to it.
UC_OWNER_EMAIL=owner@localhost

# SMTP relay (optional): email alerts + magic-link sign-in mail. Empty host =
# no outbound email at all. The relay password goes in secrets/smtp_password.
UC_SMTP_HOST=
UC_SMTP_PORT=587
UC_SMTP_USERNAME=
UC_SMTP_FROM=
UC_SMTP_FROM_NAME=UpControl

# Telegram alerts (optional): the @BotFather token goes in
# secrets/telegram_bot_token; the bot's public @handle (without @) here.
# Both empty = the app offers no Telegram destination.
UC_TELEGRAM_BOT_USERNAME=

# Error-rate incident detection job. On by default; 0 switches it off.
UC_DETECT_ENABLED=
